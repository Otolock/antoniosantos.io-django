{
  "lock": {
    "frozen": true
  },
  "nodeModulesDir": "auto",
  "imports": {
    "@tailwindcss/cli": "npm:@tailwindcss/cli@4.3.1",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@0.5.20",
    "tailwindcss": "npm:tailwindcss@4.3.1"
  },
  "tasks": {
    "tailwind:build": "deno run -A @tailwindcss/cli -i ./theme/input.css -o ./blog/static/blog/style.css",
    "tailwind:watch": "deno run -A ./scripts/tailwind-watch.ts"
  },
  "allowScripts": ["npm:@parcel/watcher"]
}
